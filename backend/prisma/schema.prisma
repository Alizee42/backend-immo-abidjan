generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  VENTE
  LOCATION
  LOCATION_VENTE
}

enum PropertyStatus {
  DISPONIBLE
  RESERVE
  VENDU
  LOUE
}

enum Categorie {
  TERRAIN_VIABILISE
  MAISON_CLES_EN_MAIN
}

enum Avancement {
  LIVRE
  EN_TRAVAUX
  PREVU
}

enum Quartier {
  QUARTIER_1
  QUARTIER_2
  QUARTIER_3
}

model Property {
  id                 Int            @id @default(autoincrement())
  titre              String
  description        String?
  type               PropertyType
  status             PropertyStatus
  categorie          Categorie      @default(MAISON_CLES_EN_MAIN)
  avancement         Avancement     @default(LIVRE)
  quartier           Quartier
  superficie         Float?
  prix               Decimal        @db.Decimal(15, 2)
  nombreChambres     Int?
  nombreSallesDeBain Int?
  photos             String[]
  // Contenu de démonstration, effaçable avec npm run demo:purge
  demo               Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("properties")
}

model Article {
  id          Int      @id @default(autoincrement())
  titre       String
  contenu     String
  resume      String
  imageUrl    String?
  auteur      String?
  tags        String[]
  publie      Boolean  @default(false)
  publishedAt DateTime @default(now())
  demo        Boolean  @default(false)

  @@map("articles")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nom          String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model ContactRequest {
  id             Int      @id @default(autoincrement())
  nom            String
  prenom         String
  email          String
  telephone      String?
  sujet          String
  message        String
  paysResidence  String?
  traite         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("contact_requests")
}

// Contenus éditables depuis l'admin (paramètres du site, textes des pages)
model Contenu {
  cle       String   @id
  valeur    Json
  updatedAt DateTime @updatedAt

  @@map("contenus")
}
